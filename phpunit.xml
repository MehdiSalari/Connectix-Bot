<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!--
            Hermetic: the suite must not inherit the live APP_URL. An https
            production URL makes route() generate https links, which flips
            every secure-cookie and HSTS assertion in the suite.
        -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            The first-run guard is off for the suite, so a test only has to run the
            migrations to get a working application. tests/Feature/SetupTest.php
            switches it back on per test to exercise the installer itself.
        -->
        <env name="CONNECTIX_SETUP_ENFORCE" value="false"/>
        <!-- The installer writes here, never into the project's own files. -->
        <env name="CONNECTIX_SETUP_STATE_FILE" value="storage/framework/testing/connectix-setup.json"/>
        <env name="CONNECTIX_SETUP_ENV_FILE" value="storage/framework/testing/connectix-setup.env"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
