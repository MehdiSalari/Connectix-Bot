# ---------------------------------------------------------------------------
# Bot settings
# ---------------------------------------------------------------------------

# Branded name shown throughout the bot and the admin panel. The legacy setup
# wizard pulled this from the seller panel (`bot.app_name`) so every reseller
# could run the same build under their own brand. When this value is left empty
# the app falls back to the name configured in your seller panel account.
CONNECTIX_BOT_APP_NAME=
CONNECTIX_BOT_ACTIVE=true
CONNECTIX_BOT_TEST_ENABLED=true
CONNECTIX_BOT_FORCE_CHANNEL_JOIN=false

# Comma separated Telegram chat ids of the administrators. When empty the
# panel-provided administrators (bot.admin_id / admin_id_2 / admin_id_3) are
# used instead, matching the legacy `setup.php` behaviour.
CONNECTIX_BOT_ADMIN_IDS=

# Leave these empty to inherit the values configured in your seller panel
# (bot.support_telegram, bot.channel_telegram, bot.channel_id). A leading "@"
# is accepted and stripped.
CONNECTIX_BOT_SUPPORT_TELEGRAM=
CONNECTIX_BOT_CHANNEL_TELEGRAM=
CONNECTIX_BOT_TELEGRAM_CHANNEL_ID=

# Card to card deposit details. Empty values inherit bot.card_number and
# bot.card_name from the seller panel.
CONNECTIX_BOT_CARD_NUMBER=
CONNECTIX_BOT_CARD_NAME=

CONNECTIX_BOT_WALLET_MIN_DEPOSIT=10000

# ---------------------------------------------------------------------------
# Bank SMS auto payment
# ---------------------------------------------------------------------------

CONNECTIX_BOT_BANK_NAME=
CONNECTIX_BOT_BANK_BOT_NOTICE=true

# ---------------------------------------------------------------------------
# External resources
# ---------------------------------------------------------------------------

CONNECTIX_BOT_TELEGRAM_APP_USERNAME=connectixapp
CONNECTIX_BOT_WEBAPP_URL=
CONNECTIX_BOT_DOWNLOADS_URL=https://connectix.space/#download
CONNECTIX_BOT_DOWNLOADS_CACHE_TTL=3600
CONNECTIX_BOT_DOWNLOADS_TIMEOUT=20

CONNECTIX_BOT_GUIDES_PATH=assets/videos/guide
CONNECTIX_BOT_GUIDES_CUSTOM_PATH=assets/videos/guide/custom
CONNECTIX_BOT_AVATAR_PATH=assets/images/avatars/bot-avatar.jpg
CONNECTIX_BOT_AVATAR_FALLBACK=assets/images/avatars/bot-avatar-sample.jpg

# ---------------------------------------------------------------------------
# Optional message overrides
# ---------------------------------------------------------------------------
# Leave every message empty to serve the texts configured in your seller panel
# (telegramMessages.*). Set one only to override that single text locally.

CONNECTIX_BOT_MESSAGE_WELCOME=
CONNECTIX_BOT_MESSAGE_SUPPORT=
CONNECTIX_BOT_MESSAGE_FAQ=
CONNECTIX_BOT_MESSAGE_TEST_CREATED=
