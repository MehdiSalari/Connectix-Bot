APP_NAME="EchoVPN"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://example.com

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=connectix_bot
DB_USERNAME=database_username
DB_PASSWORD=database_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ---------------------------------------------------------------------------
# Telegram bot
# ---------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://example.com/telegram/webhook

# ---------------------------------------------------------------------------
# Connectix seller panel API
# ---------------------------------------------------------------------------

CONNECTIX_API_BASE_URL=https://api.connectix.vip
CONNECTIX_PANEL_TOKEN=
CONNECTIX_PANEL_URL=https://seller.connectix.vip
CONNECTIX_API_TIMEOUT=30
CONNECTIX_API_CONNECT_TIMEOUT=10
CONNECTIX_VERIFY_TLS=true

# ---------------------------------------------------------------------------
# Bot settings
# ---------------------------------------------------------------------------

ECHOVPN_APP_NAME=EchoVPN
ECHOVPN_BOT_ACTIVE=true
ECHOVPN_TEST_ENABLED=true
ECHOVPN_FORCE_CHANNEL_JOIN=false

# Comma separated Telegram chat ids of the administrators
ECHOVPN_ADMIN_IDS=

ECHOVPN_SUPPORT_TELEGRAM=
ECHOVPN_CHANNEL_TELEGRAM=
ECHOVPN_TELEGRAM_CHANNEL_ID=

ECHOVPN_CARD_NUMBER=
ECHOVPN_CARD_NAME=

ECHOVPN_WALLET_MIN_DEPOSIT=10000

# ---------------------------------------------------------------------------
# Bank SMS auto payment
# ---------------------------------------------------------------------------

ECHOVPN_BANK_NAME=
ECHOVPN_BANK_BOT_NOTICE=true

# ---------------------------------------------------------------------------
# External resources
# ---------------------------------------------------------------------------

ECHOVPN_TELEGRAM_APP_USERNAME=connectixapp
ECHOVPN_WEBAPP_URL=

# Optional message overrides (leave empty to use the built-in defaults)
ECHOVPN_MESSAGE_WELCOME=
ECHOVPN_MESSAGE_SUPPORT=
ECHOVPN_MESSAGE_FAQ=
ECHOVPN_MESSAGE_TEST_CREATED=
